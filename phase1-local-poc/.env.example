# ==============================================================================
# Phase 1: Local PoC Environment Configuration
# ==============================================================================

# Database Settings
POSTGRES_DB=dtrack
POSTGRES_USER=dtrack
POSTGRES_PASSWORD=dtrackpassword

# Port Bindings on Host
DTRACK_FRONTEND_PORT=8080
DTRACK_API_PORT=8081

# Public URL of Dependency-Track API (Used by Web Browser and Scanner)
API_BASE_URL=http://localhost:8081

# Dependency-Track Automation Team API Key
# (Generated from Dependency-Track UI: Administration -> Access Management -> Teams -> Automation)
DTRACK_API_KEY=your_dtrack_api_key_here

# Corporate HTTP/HTTPS Proxy (Optional - leave blank if direct internet connection)
# HTTP_PROXY=http://proxy.corp.local:8080
# HTTPS_PROXY=http://proxy.corp.local:8080
# NO_PROXY=localhost,127.0.0.1,dtrack-db,dtrack-apiserver

# JVM Extra Options (e.g. Proxy configuration for API Server feeds)
# DTRACK_EXTRA_JAVA_OPTIONS="-Dhttp.proxyHost=proxy.corp.local -Dhttp.proxyPort=8080 -Dhttps.proxyHost=proxy.corp.local -Dhttps.proxyPort=8080"
DTRACK_EXTRA_JAVA_OPTIONS=""
