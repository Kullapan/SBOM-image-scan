# ==============================================================================
# Git Ignore Configuration for SBOM Image Scan System
# ==============================================================================

# 1. Secrets & Environment variables
.env
**/.env
*.env
*.env.local
*.env.*
!*.env.example
!**/.env.example
*.key
*.pem
*.pfx
*.pkcs12

# 2. Database & Volume Storage
data/
postgres-data/
pgdata/
*.db
*.sqlite
*.sqlite3

# 3. Cache & Temporary Scan Artifacts
.trivycache/
trivy-cache/
tmp/
temp/
*.tmp
*-cyclonedx.json
cyclonedx-bom.json
trivy-result.json

# 4. Generated Reports & Output Artifacts (keep folder tracked via .gitkeep)
reports/*
!reports/.gitkeep

# 5. Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# 6. Node / Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Application & System Logs
*.log

# 8. IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# 9. OS Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 10. Container Image Archives & Exports
*.tar
*.tar.gz
*.tgz
